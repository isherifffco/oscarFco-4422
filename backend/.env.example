# Puerto HTTP del API
PORT=3001

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# true => SnailPay responde 503 (service_unavailable) a TODAS las solicitudes de cobro.
# Sirve para simular una caída completa del servicio.
SNAILPAY_SIMULATE_OUTAGE=false

# Milisegundos que tarda en responder la tarjeta de prueba de timeout (4444 4444 4444 4444).
# Debe ser mayor que el timeout del frontend (10 s por defecto) para que el cliente aborte.
SNAILPAY_SLOW_RESPONSE_MS=15000

# Máximo de solicitudes de cobro por minuto e IP
RATE_LIMIT_PER_MINUTE=30

# Carpeta con el build del frontend para servirlo desde Express (un solo servicio).
# En producción, si no se define y existe frontend/dist, se usa automáticamente.
# STATIC_DIR=../frontend/dist

# Número de proxies de confianza (1 en plataformas como Render). 0 en local.
TRUST_PROXY=0
